@inherits Tick

<g class="rz-tick">
@if (Right)
{
  <Line class="rz-tick-line" Stroke="@Stroke" StrokeWidth="@StrokeWidth" LineType="@LineType" X1="@X" Y1="@Y" X2="@(X+6)" Y2="@Y" />
  @if (ChildContent == null)
  {
    <g>
      <text class="rz-tick-text" x="@((X+9).ToInvariantString())" dy=".3em" y="@Y.ToInvariantString()" text-anchor="start" style="text-anchor: start;">@Text</text>
    </g>
  }
  else
  {
    @ChildContent
  }
}
else
{
  <Line class="rz-tick-line" Stroke="@Stroke" StrokeWidth="@StrokeWidth" LineType="@LineType" X1="@X" Y1="@Y" X2="@(X-6)" Y2="@Y" />
  @if (ChildContent == null)
  {
    <g>
      <text class="rz-tick-text" x="@((X-9).ToInvariantString())" dy=".3em" y="@Y.ToInvariantString()">@Text</text>
    </g>
  }
  else
  {
    @ChildContent
  }
}
</g>

@code {
    /// <summary>
    /// Gets or sets whether the tick is rendered on the right (secondary) value axis,
    /// pointing the tick line and label to the right.
    /// </summary>
    [Parameter]
    public bool Right { get; set; }
}
