
@inherits RadzenChartComponentBase
@if (YAxis?.Visible == true && valueScale != null)
{
    <g class="rz-axis rz-value-axis">
    <Line class="rz-line" X1="@x1" Y1="@y1" X2="@x1" Y2="@y2" Stroke="@YAxis.Stroke" StrokeWidth="@YAxis.StrokeWidth" LineType="@YAxis.LineType" />
    @for (var idx = start; idx <= end; idx += step)
    {
        var value = valueScale.Value(idx);
        var y = valueScale.Scale(idx);
        var text = YAxis != null ? YAxis.Format(valueScale, value) : "";

        if (YAxis?.Ticks?.Template != null)
        {
            var context = new TickTemplateContext { Text = text, Value = value, X = x1, Y = y } ;

            <ValueAxisTick Right="@right" X="@x1" Y="@y" Text="@text" Stroke="@(YAxis.Ticks.Stroke ?? YAxis.Stroke)" StrokeWidth="@YAxis.Ticks.StrokeWidth" LineType="@YAxis.Ticks.LineType">
                @YAxis.Ticks.Template(context)
            </ValueAxisTick>
        }
        else if (!String.IsNullOrEmpty(text))
        {
            <ValueAxisTick Right="@right" X="@x1" Y="@y" Text="@text" Stroke="@(YAxis?.Ticks?.Stroke ?? YAxis?.Stroke)" StrokeWidth="@(YAxis?.Ticks?.StrokeWidth ?? 0)" LineType="@(YAxis?.Ticks?.LineType ?? LineType.Solid)"/>
        }

        if (Axis == AxisY.Primary && YAxis?.GridLines?.Visible == true && idx > start)
        {
            <Line class="rz-grid-line" X1="@x1" Y1="@y" X2="@x2" Y2="@y" Stroke="@(YAxis.GridLines.Stroke)" StrokeWidth="@(YAxis.GridLines.StrokeWidth)" LineType="@(YAxis.GridLines.LineType)" />
        }
    }
    @if (!String.IsNullOrEmpty(YAxis?.Title?.Text))
    {
        var titleX = right
            ? x1 + (YAxis?.Size ?? 0) - (YAxis?.Title?.Size ?? 0)
            : x1 - (YAxis?.Size ?? 0) + (YAxis?.Title?.Size ?? 0);

        <ValueAxisTitle Right="@right" X="@titleX" Y="@((y1 - y2)/2)" Text="@(YAxis?.Title?.Text ?? "")" />
    }
    </g>
}
@code {
    /// <summary>
    /// Gets or sets which value axis (primary/left or secondary/right) this component renders.
    /// </summary>
    [Parameter]
    public AxisY Axis { get; set; } = AxisY.Primary;

    double start;
    double end;
    double step;
    double x1;
    double x2;
    double y1;
    double y2;
    bool right;
    private ScaleBase? valueScale;
    private AxisBase? XAxis { get; set; }
    private AxisBase? YAxis { get; set; }

    protected override void OnParametersSet()
    {
        if (Chart == null)
        {
            return;
        }

        right = Axis == AxisY.Secondary;

        valueScale = right ? Chart.SecondaryValueScale : Chart.ValueScale;
        YAxis = right ? Chart.SecondaryValueAxis : Chart.ValueAxis;
        XAxis = Chart.CategoryAxis;

        if (Chart.ShouldInvertAxes())
        {
            YAxis = Chart.CategoryAxis;
            XAxis = Chart.ValueAxis;
            valueScale = Chart.ValueScale;
        }

        var ticks = valueScale.Ticks(YAxis?.TickDistance ?? 0);
        start = ticks.Start;
        end = ticks.End;
        step = ticks.Step;

        var categoryTicks = Chart.CategoryScale.Ticks(XAxis.TickDistance);
        x1 = right
            ? Chart.CategoryScale.Scale(categoryTicks.End)
            : Chart.CategoryScale.Scale(categoryTicks.Start);
        x2 = right
            ? Chart.CategoryScale.Scale(categoryTicks.Start)
            : Chart.CategoryScale.Scale(categoryTicks.End);
        y1 = valueScale.Scale(start);
        y2 = valueScale.Scale(end);
    }
}
