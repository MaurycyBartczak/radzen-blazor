@using Radzen.Blazor.Rendering

@inherits AxisBase
<CascadingValue Value="@this">
  @ChildContent
</CascadingValue>
@code {
    /// <summary>
    /// Gets or sets the side of the plot area on which the axis is rendered. Use
    /// <see cref="ValueAxisPosition.Right" /> to configure the secondary value axis used by
    /// series assigned to <see cref="AxisY.Secondary" />.
    /// </summary>
    /// <value>The axis position. Default is <see cref="ValueAxisPosition.Left" />.</value>
    [Parameter]
    public ValueAxisPosition Position { get; set; } = ValueAxisPosition.Left;

    internal double Measure(RadzenChart chart, ScaleBase? scale = null)
    {
        if (chart.ShouldInvertAxes())
        {
            return AxisMeasurer.YAxis(chart.ValueScale, chart.CategoryAxis, chart.CategoryAxis.Title);
        }
        else if (Visible == false)
        {
            return 0;
        }
        else
        {
            return AxisMeasurer.YAxis(scale ?? chart.ValueScale, this, Title);
        }
    }

    internal override double Size
    {
        get
        {
            if (Chart == null)
            {
                return 0;
            }

            var scale = Position == ValueAxisPosition.Right ? Chart.SecondaryValueScale : Chart.ValueScale;
            return Measure(Chart, scale);
        }
    }

    protected override void Initialize()
    {
        if (Chart == null)
        {
            return;
        }

        if (Position == ValueAxisPosition.Right)
        {
            Chart.SecondaryValueAxis = this;
        }
        else
        {
            Chart.ValueAxis = this;
        }
    }
}
